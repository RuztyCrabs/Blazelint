[rules]
camel-case = "info"
constant-case = "info"
line-length = "warn"
max-function-length = "warn"
missing-return = "error"

# Official bal scan rules
avoid-checkpanic = "warn"
self-assignment = "warn"
invalid-range = "warn"
unused-variables = "error"

[settings]
max-line-length = 120
max-function-length = 50
