// Main function to tie everything together
public function main() {
    io:println("Starting performance test...");
    
    // Call some generated functions
    int result1 = arithmeticFunction1(10, 20, 3.14);
    string result2 = stringProcessing2("test", true);
    int[] result3 = arrayProcessing3();
    
    io:println("Arithmetic result: " + result1.toString());
    io:println("String result: " + result2);
    io:println("Array length: " + result3.length().toString());
    
    // Performance test calls
    int total = 0;
    for int i in 1..100 {
        total += complexExpressions${i}(i);
    }
    
    io:println("Total from complex expressions: " + total.toString());
    io:println("Performance test completed!");
}
