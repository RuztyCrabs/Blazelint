    }
    
    return result;
}

function complexExpressions1966(int base) returns int {
    int result = base;
    
    // Bitwise operations
    result = result << 2;
    result = result ^ 0xFF;
    result = result | 0x0F;
    result = result & 0xF0;
    result = result >> 1;
    
    // Arithmetic combinations
    result += base * 3 - base / 2 + base % 7;
    result *= (base > 10) ? 2 : 3;
    
    // Boolean logic with arithmetic
    boolean isEven = result % 2 == 0;
    boolean isPositive = result > 0;
    
    if isEven && isPositive {
        result += 100;
    } else if !isEven && isPositive {
        result -= 50;
    } else {
        result = -result;
    }
    
    return result;
}

