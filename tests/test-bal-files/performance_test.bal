    int[] processed = [];
    
    foreach int num in numbers {
        int squared = num * num;
        int cubed = squared * num;
        
        if cubed % 2 == 0 {
            processed.push(cubed);
        } else {
            processed.push(squared);
        }
    }
    
    return processed;
}

function conditionalLogic203(int x, int y, boolean flag) returns string {
    string result = "default";
    
    if x > y && flag {
        if x % 2 == 0 {
            result = "even_greater";
        } else {
            result = "odd_greater";
        }
    } else if x < y && !flag {
        result = x > 0 ? "positive_lesser" : "negative_lesser";
    } else if x == y {
        result = flag ? "equal_true" : "equal_false";
    } else {
        result = "fallback_case";
    }
    
    return result;
}

function loopProcessing204(int iterations) returns int {
    int accumulator = 0;
    
    while iterations > 0 {
        for int k in 0..<10 {
            if k % 3 == 0 {
                accumulator += k * 2;
            } else if k % 3 == 1 {
                accumulator -= k;
            } else {
                accumulator *= 2;
                accumulator = accumulator % 1000;
            }
        }
        iterations -= 1;
    }
    
    return accumulator;
}

function typeHandling205(int|string|float value) returns string {
    string result = "";
    
    if value is int {
        result = "Integer: " + value.toString();
    } else if value is string {
        result = "String: " + value;
    } else if value is float {
        result = "Float: " + value.toString();
    }
    
    int len = result.length();
    if len > 50 {
        result = result.substring(0, 50) + "...";
    }
    
    return result;
}

function complexExpressions206(int base) returns int {
    int result = base;
    
    // Bitwise operations
    result = result << 2;
    result = result ^ 0xFF;
    result = result | 0x0F;
    result = result & 0xF0;
    result = result >> 1;
    
    // Arithmetic combinations
    result += base * 3 - base / 2 + base % 7;
    result *= (base > 10) ? 2 : 3;
    
    // Boolean logic with arithmetic
    boolean isEven = result % 2 == 0;
    boolean isPositive = result > 0;
    
    if isEven && isPositive {
        result += 100;
    } else if !isEven && isPositive {
        result -= 50;
    } else {
        result = -result;
    }
    
    return result;
}

function nestedScopes207(int param1, string param2) returns boolean {
    int localVar = param1;
    string localString = param2;
    boolean success = false;
    
    {
        int innerVar = localVar * 2;
        string innerString = localString + "_inner";
        
        if innerVar > 0 {
            final int constant = 42;
            int temp = innerVar + constant;
            
            if temp % 7 == 0 {
                success = true;
                localVar = temp;
            }
        }
    }
    
    if success {
        localString = localString.toUpperAscii();
        return localString.length() > 5;
    }
    
    return false;
}

